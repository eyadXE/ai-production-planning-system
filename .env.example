# Ousus backend configuration — copy to .env and fill in.
# Loaded automatically by the API on startup.

# --- LLM providers (free tiers; first one found wins, chain falls back) ---
# Gemini free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Groq free tier (https://console.groq.com/keys)
GROQ_API_KEY=
# OpenRouter free models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Local fallback needs no key — install https://ollama.com and `ollama pull llama3.2`
OUSUS_OLLAMA_MODEL=llama3.2
OUSUS_OLLAMA_URL=http://localhost:11434/v1/chat/completions

# --- Auth ---
OUSUS_JWT_SECRET=change-me-to-a-long-random-string
OUSUS_TOKEN_TTL_MINUTES=720

# --- Email notifications (optional; without these, emails are written to data/email_outbox.log) ---
OUSUS_SMTP_HOST=
OUSUS_SMTP_PORT=587
OUSUS_SMTP_FROM=no-reply@ousus.example
OUSUS_SMTP_USER=
OUSUS_SMTP_PASS=

# --- Database ---
OUSUS_DB=data/ousus.db
